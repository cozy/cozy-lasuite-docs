.iframesContainer
  display: flex
  flex-direction: row
  width 100%
  height 100%
  overflow hidden
  position relative

  iframe
    border none
    height 100%
    & + iframe
      border-left 1px solid #ccc

  .controllerApp
    width 400px

  .embeddedApp
    flex 1
    width 100%

  .controllerApp--mobile
    position: absolute
    top: 0
    left: -100%
    width: calc(100% - 50px)
    height: calc(100vh - 48px)
    z-index: 10
    padding-right: calc(100% + 50px)
    background: #00000000
    pointer-events: none

    transition: left 0.3s ease, background 0.3s ease, padding-right 0.3s ease

  .controllerApp--mobile.open
    pointer-events: auto
    background: #00000055
    left: 0

  .controllerApp--desktop
    margin-left: -400px

    transition: margin-left 0.3s ease

  .controllerApp--desktop.open
    margin-left: 0
