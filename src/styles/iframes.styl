.iframesContainer
    display flex
    flex-direction row
    width 100%
    height 100%
    overflow hidden
    position relative

    iframe
        border 0
        height 100%

    .controllerApp
        width 400px

    .embeddedApp
        flex 1
        width 100%

    .controllerApp--mobile
        position absolute
        top 0
        left -100%
        width calc(100% - 50px)
        height calc(100vh - 48px)
        z-index 10
        padding-right calc(100% + 50px)
        background transparent
        pointer-events none

        transition left .3s, background .3s, padding-right .3s
        transition-timing-function ease-in-out

    .controllerApp--mobile.open
        pointer-events auto
        background var(--lt-shadowActive)
        left 0

    .controllerApp--desktop
        margin-left -400px
        border-right 1px solid transparent

        transition margin-left .4s, border-color .15s
        transition-timing-function ease-in-out

    .controllerApp--desktop.open
        margin-left 0
        border-color var(--dividerColor)
